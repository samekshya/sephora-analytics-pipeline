# Copy to .env before running anything:
#
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
#
# The values below are WORKING LOCAL DEFAULTS, not placeholders — they match
# docker-compose.yml, so a fresh clone runs with this file copied verbatim.
# They are development credentials for a container bound to localhost. Change
# the passwords for anything that is not that.
#
# .env itself is gitignored and must never be committed.

# --- OLTP database (raw + 3nf + staging schemas) ---
# Port 5434, not 5432. Ports 5432 and 5433 on the original dev machine belong
# to unrelated stacks; this project runs its own container so a stray command
# cannot hit the wrong database. If you change it, change docker-compose.yml
# and the Airflow connections to match.
OLTP_DB_HOST=localhost
OLTP_DB_PORT=5434
OLTP_DB_NAME=sephora_oltp
OLTP_DB_USER=postgres
OLTP_DB_PASSWORD=postgres

# --- Data warehouse (star schema) ---
# Same server, different database (D7). sephora_dw is created on first boot by
# sql/init/, because the postgres image only creates one database itself.
DW_DB_HOST=localhost
DW_DB_PORT=5434
DW_DB_NAME=sephora_dw
DW_DB_USER=postgres
DW_DB_PASSWORD=postgres

# --- Airflow (docker-compose-airflow.yml) ---
# AIRFLOW_UID must match your host user on Linux/WSL or the scheduler cannot
# write to ./logs. 50000 is the image default and is correct on Windows.
AIRFLOW_UID=50000

# Leave FERNET_KEY blank for local use — Airflow generates an ephemeral one.
# Set it in any shared environment, or connection passwords become
# unreadable after a restart:
#   py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret

# NOTE: the two Airflow connections (sephora_oltp / sephora_dw) are NOT set
# here. docker-compose-airflow.yml builds them from the variables above as
# AIRFLOW_CONN_* env vars, so there is nothing to register by hand and no
# connection to re-create after a `docker compose down`.
#
# They point at `postgres:5432`, not `localhost:5434`: both compose files share
# `name: leapfrog-sephora`, so Airflow and Postgres sit on the same Docker
# network and Airflow reaches it by SERVICE NAME on its INTERNAL port. From
# inside the scheduler container, localhost:5434 is the scheduler itself.
